+            // "big-fast-then-burst" sends a 3 MiB fast head then 300 KiB every 3 s (~100 KiB/s tail).
+            for (path in listOf("/pack/files/big.jar", "/pack/$bigHex")) createContext(path) { exchange ->
+                val range = exchange.requestHeaders.getFirst("Range") ?: "none"
+                ranges.add(range)
+                try {
+                    if (mode != "big-ok" && mode != "big-fast-then-burst") {
+                        exchange.sendResponseHeaders(404, -1)
+                        return@createContext
+                    }
