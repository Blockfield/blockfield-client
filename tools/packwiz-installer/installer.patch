+    /** A pack host or mirror serving the file by path and by hash; [mode] picks how it misbehaves. */
+    private class Host(val mode: String) {
+        val ranges = CopyOnWriteArrayList<String>()
+        private var fileDrops = 1
+        val server: HttpServer = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0).apply {
+            for (path in listOf("/pack/files/a.jar", "/pack/$hex")) createContext(path) { exchange ->
+                val range = exchange.requestHeaders.getFirst("Range") ?: "none"
+                ranges.add(range)
+                try {
+                    if (mode == "missing") {
+                        exchange.sendResponseHeaders(404, -1)
+                        return@createContext
+                    }
+                    val (start, end) = if (range == "none") 0 to bytes.size - 1 else range.removePrefix("bytes=")
+                        .split("-").let { (a, b) -> a.toInt() to (b.toIntOrNull() ?: (bytes.size - 1)) }
+                    if (range != "none") exchange.responseHeaders.add("Content-Range", "bytes $start-$end/${bytes.size}")
+                    val full = end - start + 1 > Mirrors.PROBE_BYTES
+                    if (mode == "drop-then-ignore" && full && range == "none" && fileDrops-- > 0) {
+                        // First full attempt sends half the file, then the connection dies mid-body.
+                        exchange.sendResponseHeaders(200, bytes.size.toLong())
+                        exchange.responseBody.write(bytes, 0, bytes.size / 2)
+                        exchange.responseBody.flush()
+                        return@createContext
+                    }
+                    if (mode == "ignore-resume" && full && range != "none") {
+                        // Ignores Range and restarts the file from zero (HTTP 200 on a resume request).
+                        exchange.sendResponseHeaders(200, bytes.size.toLong())
+                        exchange.responseBody.write(bytes, 0, bytes.size)
+                        exchange.responseBody.flush()
+                        return@createContext
+                    }
+                    if (mode == "ignore-resume" && !full && range != "none") {
+                        // Slow probe body (~440 KiB/s: above the floor, far below the drop host).
+                        // (Ranked by body speed timed from the first bytes, so a pre-header delay
+                        // would not count.)
+                        exchange.responseHeaders.add("Content-Range", "bytes $start-$end/${bytes.size}")
+                        exchange.sendResponseHeaders(206, (end - start + 1).toLong())
+                        for (chunk in start until end + 1 step 64 * 1024) {
+                            exchange.responseBody.write(bytes, chunk, minOf(64 * 1024, end + 1 - chunk))
+                            exchange.responseBody.flush()
+                            Thread.sleep(150)
+                        }
+                        return@createContext
+                    }
+                    exchange.sendResponseHeaders(if (range == "none") 200 else 206, (end - start + 1).toLong())
