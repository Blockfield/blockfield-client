+                        // 10 s threshold passes) while the tail averages ~100 KiB/s.
+                        var chunk = maxOf(start, 3 * 1024 * 1024)
+                        while (chunk <= end) {
+                            val burstEnd = minOf(chunk + 700 * 1024, end + 1)
+                            exchange.responseBody.write(bigBytes, chunk, burstEnd - chunk)
+                            exchange.responseBody.flush()
+                            chunk = burstEnd
+                            if (chunk <= end) Thread.sleep(7000)
+                        }
+                        return@createContext
+                    }
+                    if (range != "none") exchange.responseHeaders.add("Content-Range", "bytes $start-$end/${bigBytes.size}")
+                    exchange.sendResponseHeaders(if (range == "none") 200 else 206, (end - start + 1).toLong())
+                    exchange.responseBody.write(bigBytes, start, end - start + 1)
+                    exchange.responseBody.flush()
+                } catch (_: IOException) {
+                    // The client gave up on a stalled transfer.
+                } finally {
+                    exchange.close()
+                }
+            }
+            start()
+        }
+        val base get() = "http://127.0.0.1:${server.address.port}/pack/"
+    }
