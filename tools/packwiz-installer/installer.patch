diff --git a/src/main/kotlin/link/infra/packwiz/installer/Mirrors.kt b/src/main/kotlin/link/infra/packwiz/installer/Mirrors.kt
new file mode 100644
index 0000000..4933936
--- /dev/null
+++ b/src/main/kotlin/link/infra/packwiz/installer/Mirrors.kt
@@ -0,0 +1,146 @@
+package link.infra.packwiz.installer
+
+import com.google.gson.JsonParser
+import link.infra.packwiz.installer.metadata.hash.Hash
+import link.infra.packwiz.installer.target.ClientHolder
+import link.infra.packwiz.installer.target.path.HttpUrlPath
+import link.infra.packwiz.installer.target.path.PackwizPath
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.util.Collections
+import java.util.Locale
+import java.util.concurrent.TimeUnit.MILLISECONDS
+
+/**
+ * Download mirrors of the pack host, listed in mirrors.json beside pack.toml:
+ * {"schema":1,"probe":{"path":"files/a.jar","hash":"<hex>"},"mirrors":[{"name":"CDN","url":"https://cdn.example/{path}"}]}.
+ * {path} is the file's URL relative to the pack host, {hash} the hex hash the pack declares for it, so a mirror can
+ * proxy the host or store files by content. Every file is still checked against that hash. Mirrors are ranked once
+ * per run by fetching the same probe slice from each; the pack host is only the last resort, so it is not probed.
+ */
+internal class Mirrors(
+    private val base: String,
+    private val listed: List<Mirror>,
+    private val probe: Pair<String, String>?,
+    client: ClientHolder,
+    private val timeoutMs: Long = 8000,
+) {
+    class Mirror(val name: String, val url: String) {
+        fun resolve(path: String?, hash: String): String? =
+            if (path == null && "{path}" in url) null else url.replace("{path}", path ?: "").replace("{hash}", hash)
+    }
+
+    private val failed = Collections.synchronizedSet(HashSet<Mirror>())
+    private val direct = base.toHttpUrlOrNull()?.host ?: base
+    private val speeds = HashMap<Mirror, Double>()
+
+    // Without the shared client's timeout retries (10+15+60 s): a mirror that stalls, like the
+    // Russian 16 KB cut of Cloudflare, must hand over to the next source quickly.
+    val http: OkHttpClient = client.okHttpClient.newBuilder().apply { interceptors().clear() }
+        .connectTimeout(timeoutMs, MILLISECONDS)
+        .readTimeout(timeoutMs, MILLISECONDS)
+        .build()
+
+    private val ranked: List<Mirror> by lazy { rank().also { announce(it) } }
+
+    /** Mirror URLs for a file at [url] with [hash] in preference order, then [url] itself. */
+    fun candidates(url: String, hash: Hash<*>): List<Pair<Mirror, String>> {
+        if (listed.isEmpty()) return emptyList()
+        val path = if (url.startsWith(base)) url.substring(base.length) else null
+        val hex = hex(hash)
+        return ranked.filter { it !in failed }.mapNotNull { mirror -> mirror.resolve(path, hex)?.let { mirror to it } }
+    }
+
+    fun skips(mirror: Mirror) = mirror in failed
+
+    // Synchronized so the announcements of concurrent failures cannot arrive out of order.
+    @Synchronized
+    fun failed(mirror: Mirror) {
+        if (!failed.add(mirror)) return
+        println("Mirror ${mirror.name} failed; the rest of this run skips it")
+        announce(ranked)
+    }
+
+    /** "[blockfield-mirror] NAME 12.3 MB/s": the source the launcher shows as the current one. */
+    private fun announce(order: List<Mirror>) {
+        val current = order.firstOrNull { it !in failed }
+        val speed = current?.let { speeds[it] }?.let { String.format(Locale.ROOT, " %.1f MB/s", it / 1e6) } ?: ""
+        println("[blockfield-mirror] ${current?.name ?: direct}$speed")
+    }
+
+    private fun rank(): List<Mirror> {
+        val (path, hash) = probe ?: return emptyList()
+        val measured = arrayOfNulls<Double>(listed.size)
+        listed.mapIndexed { i, mirror -> Thread { measured[i] = mirror.resolve(path, hash)?.let(::speed) }.apply { start() } }
+            .forEach { it.join() }
+        listed.forEachIndexed { i, mirror -> measured[i]?.let { speeds[mirror] = it } }
+        println("Mirror probe: " + listed.indices.joinToString {
+            listed[it].name + " " + (measured[it]?.let { s -> String.format(Locale.ROOT, "%.1f MB/s", s / 1e6) } ?: "failed")
+        })
+        return listed.indices.filter { (measured[it] ?: 0.0) >= MIN_SPEED }
+            .sortedByDescending { measured[it] }
+            .map { listed[it] }
+    }
+
+    private fun speed(url: String): Double? = try {
+        val request = Request.Builder().url(url)
+            .header("Range", "bytes=0-${PROBE_BYTES - 1}")
+            .header("Accept-Encoding", "identity")
+            .header("User-Agent", AGENT)
+            .build()
+        val call = http.newCall(request)
+        call.timeout().timeout(timeoutMs, MILLISECONDS)
+        call.execute().use { response ->
+            if (response.code != 200 && response.code != 206) null
+            else {
+                // From the first response bytes: connection setup and redirects say little about bulk speed.
+                val start = System.nanoTime()
+                response.body!!.source().skip(PROBE_BYTES)
+                PROBE_BYTES * 1e9 / (System.nanoTime() - start)
+            }
+        }
+    } catch (error: Exception) {
+        null
+    }
+
+    companion object {
+        const val PROBE_BYTES = 512L * 1024
+
+        // Below about 1 Mbit/s a mirror is throttled rather than working; the next source does better.
+        const val MIN_SPEED = 128.0 * 1024
+        private const val AGENT = "packwiz-installer/blockfield-mirrors"
+
+        fun <T> hex(hash: Hash<T>): String = hash.type.encodeToString(hash.value)
+
+        /** Mirrors of [packFile]'s host; none when mirrors.json is absent or invalid. */
+        fun load(packFile: PackwizPath<*>, client: ClientHolder): Mirrors {
+            val base = packFile.toString().substringBeforeLast('/') + "/"
+            val none = Mirrors(base, emptyList(), null, client)
+            if (packFile !is HttpUrlPath) return none
+            return try {
+                val request = Request.Builder().url(base + "mirrors.json").header("User-Agent", AGENT).build()
+                none.http.newCall(request).execute().use { response ->
+                    if (response.code == 404) return none
+                    check(response.isSuccessful) { "HTTP ${response.code}" }
+                    val root = JsonParser.parseString(response.body!!.string()).asJsonObject
+                    check(root["schema"].asInt == 1) { "schema ${root["schema"]}" }
+                    val probe = root["probe"].asJsonObject.let { it["path"].asString to it["hash"].asString }
+                    check(!probe.first.startsWith("/") && probe.first.split('/').none { it == ".." || it.isEmpty() }) {
+                        "probe ${probe.first}"
+                    }
+                    check(probe.second.matches(Regex("[0-9a-f]+"))) { "probe hash" }
+                    val listed = root["mirrors"].asJsonArray.map { entry ->
+                        val mirror = entry.asJsonObject
+                        Mirror(mirror["name"].asString, mirror["url"].asString)
+                    }
+                    check(listed.all { it.url.startsWith("https://") && it.name.isNotBlank() }) { "mirror list" }
+                    Mirrors(base, listed, probe, client)
+                }
+            } catch (error: Exception) {
+                println("Ignoring mirrors.json: $error")
+                none
+            }
+        }
+    }
+}
diff --git a/src/main/kotlin/link/infra/packwiz/installer/ResumableDownload.kt b/src/main/kotlin/link/infra/packwiz/installer/ResumableDownload.kt
new file mode 100644
index 0000000..c33c4cc
--- /dev/null
+++ b/src/main/kotlin/link/infra/packwiz/installer/ResumableDownload.kt
@@ -0,0 +1,196 @@
+package link.infra.packwiz.installer
+
+import link.infra.packwiz.installer.metadata.hash.Hash
+import link.infra.packwiz.installer.target.ClientHolder
+import link.infra.packwiz.installer.target.path.HttpUrlPath
+import link.infra.packwiz.installer.target.path.PackwizPath
+import com.google.gson.Gson
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okio.ByteString.Companion.encodeUtf8
+import okio.blackholeSink
+import okio.buffer
+import okio.source
+import java.io.IOException
+import java.nio.file.AtomicMoveNotSupportedException
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption.*
+import java.nio.file.StandardOpenOption.*
+
+internal object ResumableDownload {
+    // Same floor as the probe (Mirrors.MIN_SPEED): a source that trickles below ~1 Mbit/s over a full
+    // window is throttled rather than working, so the next source takes over instead of looking stuck.
+    const val STALL_WINDOW_SEC = 10L
+    private const val PROGRESS_EVERY_MS = 2000L
+
+    fun download(source: PackwizPath<*>, client: ClientHolder, destination: Path, cache: Path, hash: Hash<*>,
+                 mirrors: Mirrors? = null) {
+        Files.createDirectories(destination.toAbsolutePath().parent)
+        Files.createDirectories(cache)
+        require(!Files.isSymbolicLink(cache)) { "Download cache must not be a symlink" }
+        val prefix = destination.toAbsolutePath().normalize().toString().encodeUtf8().sha256().hex() + "-"
+        // .partial survives the launcher's cleanup of its unrelated .part files.
+        val partial = cache.resolve(prefix + hash.toString().encodeUtf8().sha256().hex() + ".partial")
+        require(!Files.isSymbolicLink(partial)) { "Download partial must not be a symlink" }
+        Files.newDirectoryStream(cache, "$prefix*.partial").use { files ->
+            for (file in files) if (file != partial) Files.deleteIfExists(file)
+        }
+        val name = destination.fileName.toString()
+
+        var valid = Files.exists(partial) && matches(partial, hash)
+        // One try per mirror; the partial carries over, so the next source resumes where this one stopped.
+        if (source is HttpUrlPath && mirrors != null) for ((mirror, url) in mirrors.candidates(source.toString(), hash)) {
+            if (valid) break
+            if (mirrors.skips(mirror)) continue
+            try {
+                val resumed = Files.exists(partial) && Files.size(partial) > 0
+                receive(url, mirrors.http, partial, name, mirror.name, Mirrors.MIN_SPEED.toLong(), hash)
+                valid = matches(partial, hash)
+                if (!valid && resumed) {
+                    // The bad bytes may come from an earlier source: one clean try before blaming this mirror.
+                    Files.deleteIfExists(partial)
+                    receive(url, mirrors.http, partial, name, mirror.name, Mirrors.MIN_SPEED.toLong(), hash)
+                    valid = matches(partial, hash)
+                }
+                if (!valid) {
+                    Files.deleteIfExists(partial)
+                    throw IOException("Invalid hash")
+                }
+            } catch (error: Exception) {
+                // A failed attempt may still have left a complete, hash-correct file (unknown length,
+                // abort on the final bytes): verify before blacklisting it and failing over.
+                if (Files.exists(partial) && matches(partial, hash)) {
+                    println("$name completed by ${mirror.name}; keeping it despite (${error.message})")
+                    valid = true
+                    break
+                }
+                println("$name from ${mirror.name} failed (${error.message}); trying the next source")
+                mirrors.failed(mirror)
+            }
+        }
+        for (attempt in 1..3) {
+            if (valid) break
+            try {
+                // The pack host is the last resort: no stall watchdog, so a slow link still completes.
+                if (source is HttpUrlPath) receive(source.toString(), client.okHttpClient, partial, name, "pack host", 0, hash)
+                else source.source(client).use { input ->
+                    Files.newOutputStream(partial).buffered().use { output -> input.inputStream().copyTo(output) }
+                }
+                valid = matches(partial, hash)
+                if (!valid) {
+                    Files.deleteIfExists(partial)
+                    throw IOException("Invalid hash for $name")
+                }
+            } catch (error: IOException) {
+                // Same as above: a complete partial counts as success instead of a retry.
+                if (Files.exists(partial) && matches(partial, hash)) {
+                    println("$name completed by the pack host; keeping it despite (${error.message})")
+                    valid = true
+                    break
+                }
+                if (attempt == 3) throw error
+                println("Retrying $name ($attempt/3); keeping downloaded bytes")
+                Thread.sleep(250L * attempt)
+            }
+        }
+        check(valid) { "Download has not been verified" }
+        try {
+            Files.move(partial, destination, ATOMIC_MOVE, REPLACE_EXISTING)
+        } catch (error: AtomicMoveNotSupportedException) {
+            Files.move(partial, destination, REPLACE_EXISTING)
+        }
+    }
+
+    private fun matches(path: Path, expected: Hash<*>): Boolean {
+        val input = expected.type.source(Files.newInputStream(path).source())
+        input.buffer().use { it.readAll(blackholeSink()) }
+        return input.hash == expected
+    }
+
+    private fun receive(url: String, http: OkHttpClient, partial: Path, name: String, source: String,
+                        stallFloor: Long, hash: Hash<*>) {
+        val offset = if (Files.exists(partial)) Files.size(partial) else 0L
+        val request = Request.Builder().url(url)
+            .header("Accept", "application/octet-stream")
+            .header("Accept-Encoding", "identity")
+            .header("User-Agent", "packwiz-installer/blockfield-resume")
+        if (offset > 0) request.header("Range", "bytes=$offset-")
+        http.newCall(request.build()).execute().use { response ->
+            if (response.code == 416) {
+                // A complete partial needs no range: verify it instead of deleting it.
+                if (Files.exists(partial) && matches(partial, hash)) return
+                Files.deleteIfExists(partial)
+                throw IOException("Range rejected; restarting ${partial.fileName}")
+            }
+            if (response.code == 408 || response.code == 429 || response.code in 500..599)
+                throw IOException("HTTP ${response.code}")
+            check(response.code == 200 || response.code == 206) { "HTTP ${response.code}" }
+            check(response.header("Content-Encoding", "identity").equals("identity", ignoreCase = true)) {
+                "Encoded response cannot be resumed safely"
+            }
+            val body = response.body ?: throw IOException("Missing response body")
+            var total = body.contentLength()
+            if (response.code == 206) {
+                val range = Regex("bytes ([0-9]+)-([0-9]+)/([0-9]+)")
+                    .matchEntire(response.header("Content-Range") ?: "")
+                    ?: throw IOException("Invalid Content-Range")
+                val (start, end, size) = range.destructured
+                total = size.toLong()
+                if (start.toLong() != offset || end.toLong() < offset || end.toLong() >= total
+                    || body.contentLength() >= 0 && body.contentLength() != end.toLong() - offset + 1)
+                    throw IOException("Inconsistent Content-Range")
+                if (offset > 0) println("Resuming ${url.substringAfterLast('/')} from $offset bytes")
+            }
+            val append = response.code == 206
+            val output = Files.newOutputStream(partial, CREATE, WRITE, if (append) APPEND else TRUNCATE_EXISTING)
+                .buffered(64 * 1024)
+            output.use {
+                val input = body.byteStream()
+                val chunk = ByteArray(64 * 1024)
+                // A 200 reply to a resume request restarts the file from zero on disk: count from zero too.
+                var received = if (append) offset else 0L
+                var windowStart = System.nanoTime()
+                var windowBytes = 0L
+                var lastReport = windowStart
+                report(name, source, received, total)
+                while (true) {
+                    val n = input.read(chunk)
+                    if (n < 0) break
+                    output.write(chunk, 0, n)
+                    received += n
+                    windowBytes += n
+                    val now = System.nanoTime()
+                    if (now - windowStart >= STALL_WINDOW_SEC * 1_000_000_000) {
+                        // A known-complete response is never aborted: EOF/length/hash validate it below.
+                        // Otherwise the window's bytes are compared against its actual elapsed time, so
+                        // bursts straddling window edges fail over just like steady trickles and a
+                        // collapse after a fast start does.
+                        val complete = total >= 0 && received >= total
+                        val windowSlow = windowBytes * 1_000_000_000 < stallFloor * (now - windowStart)
+                        if (!complete && stallFloor > 0 && windowSlow)
+                            throw IOException("Stalled below ${stallFloor / 1024} KiB/s; keeping $received bytes")
+                        windowStart = now
+                        windowBytes = 0
+                    }
+                    if (now - lastReport >= PROGRESS_EVERY_MS * 1_000_000) {
+                        report(name, source, received, total)
+                        lastReport = now
+                    }
+                }
+                // Files under ~2 s never print again; the completion line already names them.
+            }
+            if (total >= 0 && Files.size(partial) != total)
+                throw IOException("Incomplete response; keeping ${Files.size(partial)} bytes")
+        }
+    }
+
+    // Parsed by the launcher into the live "current file" row; throttled above so 10 threads stay readable.
+    // JSON so spaces, quotes and Unicode in names survive the trip (Gson is already a dependency).
+    private val json = Gson()
+
+    private fun report(name: String, source: String, received: Long, total: Long) {
+        println("[blockfield-file] {\"name\":${json.toJson(name)},\"received\":$received," +
+            "\"total\":${if (total >= 0) total.toString() else "null"},\"source\":${json.toJson(source)}}")
+    }
+}
