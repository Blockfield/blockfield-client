+            check(absent.candidates(direct.base + "files/a.jar", hash).isEmpty())
+            println("PASS: probe ranking, missing, stalled, throttled, mid-file stall with resume, trickle failover, bursty failover, fast-then-bursty failover, complete past the window, unknown-length complete, ignored-Range restart, corrupt mirror, bad prefix, local pack, hash layout, absent mirrors.json")
+        } finally {
+            hosts.forEach { it.server.stop(0) }
+            client.close()
+            Files.walk(root).use { it.sorted(Comparator.reverseOrder()).forEach(Files::delete) }
+        }
+    }
+}
