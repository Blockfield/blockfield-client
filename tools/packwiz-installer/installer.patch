+                            exchange.responseBody.write(data, chunk, minOf(64 * 1024, cut - chunk))
+                            exchange.responseBody.flush()
+                            Thread.sleep(5000)
+                        }
+                    } else if (mode == "burst-file" && end - start + 1 > Mirrors.PROBE_BYTES) {
