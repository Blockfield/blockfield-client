+                        exchange.sendResponseHeaders(200, 0)
+                        exchange.responseBody.write(smallBytes, 0, 512 * 1024)
+                        exchange.responseBody.flush()
+                        Thread.sleep(7000)
+                        exchange.responseBody.write(smallBytes, 512 * 1024, smallBytes.size - 512 * 1024 - 4096)
+                        exchange.responseBody.flush()
+                        Thread.sleep(4000)
+                        exchange.responseBody.write(smallBytes, smallBytes.size - 4096, 4096)
+                        exchange.responseBody.flush()
+                    } else if (range == "none") {
