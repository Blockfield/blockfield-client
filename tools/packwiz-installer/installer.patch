+package link.infra.packwiz.installer
+
+import com.sun.net.httpserver.HttpServer
+import link.infra.packwiz.installer.metadata.hash.HashFormat
+import link.infra.packwiz.installer.target.ClientHolder
+import link.infra.packwiz.installer.target.path.HttpUrlPath
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okio.ByteString.Companion.toByteString
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.nio.file.Files
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+object ResumeChecks {
+    @JvmStatic
+    fun main(args: Array<String>) {
+        val root = Files.createTempDirectory("packwiz-resume-check-")
+        val cache = root.resolve("cache")
+        val destination = root.resolve("mods/test.jar")
+        val old = "installed version".toByteArray()
+        var bytes = ByteArray(512 * 1024) { (it * 31).toByte() }
+        val mode = AtomicReference("drop-once")
+        val ranges = CopyOnWriteArrayList<String>()
+        val served = java.util.concurrent.atomic.AtomicLong()
+        val server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        server.createContext("/file") { exchange ->
+            val range = exchange.requestHeaders.getFirst("Range") ?: "none"
+            ranges.add(range)
+            val action = mode.get()
+            if (action == "unavailable") {
+                exchange.sendResponseHeaders(503, -1)
+                exchange.close()
+            } else if (action == "reject-range" && range != "none") {
+                mode.set("healthy")
+                exchange.sendResponseHeaders(416, -1)
+                exchange.close()
+            } else {
+                val offset = if (range == "none" || action == "ignore-range") 0 else range.removePrefix("bytes=").removeSuffix("-").toInt()
+                if (offset > 0) exchange.responseHeaders.add("Content-Range",
+                    "bytes ${offset + if (action == "bad-range") 1 else 0}-${bytes.size - 1}/${bytes.size}")
+                exchange.sendResponseHeaders(if (offset > 0) 206 else 200, (bytes.size - offset).toLong())
+                try {
+                    exchange.responseBody.use { output ->
+                        val count = if (action.startsWith("drop-")) bytes.size / 2 else bytes.size - offset
+                        val data = if (action == "corrupt") ByteArray(bytes.size) else bytes
+                        output.write(data, offset, count)
+                        output.flush()
+                        served.addAndGet(count.toLong())
+                        if (action == "drop-once") mode.set("healthy")
+                        if (action == "drop-stop") mode.set("unavailable")
+                    }
+                } catch (_: IOException) {
+                    // Deliberately close a truncated HTTP body to exercise a real network interruption.
+                } finally { exchange.close() }
+            }
+        }
+        server.start()
+        val client = ClientHolder()
+        val source = HttpUrlPath("http://127.0.0.1:${server.address.port}/file".toHttpUrl())
+        fun download() = ResumableDownload.download(source, client, destination, cache,
+            HashFormat.SHA256.fromString(bytes.toByteString().sha256().hex()))
+        fun reset(action: String) {
+            ranges.clear()
+            served.set(0)
+            mode.set(action)
+            Files.createDirectories(destination.toAbsolutePath().parent)
+            Files.write(destination, old)
+        }
+        fun partial() = Files.list(cache).use { it.findFirst().get() }
+        fun fails() {
+            check(runCatching { download() }.isFailure)
+            check(Files.readAllBytes(destination).contentEquals(old)) { "Existing installation was overwritten" }
+        }
+        fun correct() {
+            check(Files.readAllBytes(destination).contentEquals(bytes))
+            check(Files.list(cache).use { !it.findAny().isPresent })
+        }
+        try {
+            reset("drop-once")
+            download()
+            correct()
+            check(ranges == listOf("none", "bytes=${bytes.size / 2}-"))
+            check(served.get() == bytes.size.toLong()) { "Resume downloaded the prefix twice" }
+            println("Interrupted transfer: ${served.get()} bytes sent for a ${bytes.size}-byte file")
+
+            for (action in listOf("healthy", "ignore-range", "reject-range", "bad-range", "completed", "changed-hash")) {
+                reset("drop-stop")
+                fails()
+                check(Files.size(partial()) == (bytes.size / 2).toLong())
+                ranges.clear()
+                mode.set(action)
+                if (action == "bad-range") {
+                    fails()
+                    check(Files.size(partial()) == (bytes.size / 2).toLong())
+                    mode.set("healthy")
+                }
+                if (action == "completed") Files.write(partial(), bytes)
+                if (action == "changed-hash") bytes = bytes.map { (it + 1).toByte() }.toByteArray()
+                download()
+                correct()
+                if (action == "completed") check(ranges.isEmpty())
+                else if (action == "changed-hash") check(ranges.first() == "none")
+                else check(ranges.first() == "bytes=${bytes.size / 2}-")
+            }
+            reset("corrupt")
+            fails()
+            check(Files.list(cache).use { !it.findAny().isPresent })
+            mode.set("healthy")
+            download()
+            correct()
+            println("PASS: retry, restart, ignored/rejected/malformed ranges, completed partial, changed hash, corruption, safe replacement")
+        } finally {
+            server.stop(0)
+            client.close()
+            Files.walk(root).use { it.sorted(Comparator.reverseOrder()).forEach(Files::delete) }
+        }
+    }
+}
