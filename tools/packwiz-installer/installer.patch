+                        // complete, so the watchdog must let EOF/length/hash validate it, not abort it.
+                        exchange.sendResponseHeaders(200, smallBytes.size.toLong())
+                        exchange.responseBody.write(smallBytes, 0, smallBytes.size - 4096)
+                        exchange.responseBody.flush()
+                        Thread.sleep(10500)
+                        exchange.responseBody.write(smallBytes, smallBytes.size - 4096, 4096)
+                        exchange.responseBody.flush()
+                    } else {
